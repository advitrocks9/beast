# =============================================================================
# Beast environment
#
# Copy to .env.local at the repo root; apps/web/next.config.ts loads it, so no
# symlink into apps/web is needed. Validation happens once at boot in
# packages/shared/src/env.ts: an empty string counts as unset, and a missing
# required var fails loudly with the full list.
#
# Two ways to run:
#
#   1. Demo mode: DATABASE_URL plus NEXT_PUBLIC_DEMO_MODE=1. Auth is bypassed
#      to a seeded founder and every external service is stubbed and labelled.
#      This is exactly what the public demo runs on.
#
#   2. Product mode: everything in section 2. Real auth, background workers,
#      billing, uploads, publishing.
# =============================================================================

# --- 1. Demo mode -----------------------------------------------------------
# "1" bypasses Supabase auth and disables all paid/external calls.
NEXT_PUBLIC_DEMO_MODE=

# Required always. Any Postgres with pgvector; `docker compose up -d` exposes one:
DATABASE_URL=postgresql://postgres:beast@localhost:5544/beast

# Model provider, resolved in order: ANTHROPIC_API_KEY, else OPENROUTER_API_KEY
# (OpenAI-compatible, free-tier models), else a deterministic stub provider that
# streams fixture trajectories. All three run the full loop.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# OpenRouter model override, plus optional per-tier overrides (fast is used for
# classification, standard for execution, deep for planning/synthesis).
OPENROUTER_MODEL=
OPENROUTER_MODEL_FAST=
OPENROUTER_MODEL_STANDARD=
OPENROUTER_MODEL_DEEP=

# Embeddings for semantic memory + knowledge search. Without it a deterministic
# local hash embedder keeps the pgvector paths exercised.
GEMINI_API_KEY=

# Wall-clock cap per agent run in ms (default 240000). Keep under your host's
# route timeout; Vercel hobby caps route handlers at 300s.
RUN_MAX_WALL_MS=

# Bearer secret for /api/cron/tick, the orchestrator entrypoint when
# Trigger.dev is not configured (Vercel cron or any external scheduler).
CRON_SECRET=

# Demo overlay limits. Live runs per visitor session (default 2), live runs per
# hashed IP per day (default 4), and the global daily live-run budget across
# all visitors (default 50). Past any limit, runs are simulated and say so.
DEMO_RUNS_PER_SESSION=
DEMO_RUNS_PER_IP_DAILY=
DEMO_DAILY_TOKEN_BUDGET=

# --- 2. Product mode --------------------------------------------------------

# Real auth (Supabase). Create a free project at supabase.com; point
# DATABASE_URL above at its pooled connection string.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Background workers (Trigger.dev): agent loop, scheduled check-ins, token
# refresh, auto-publish. TRIGGER_PROJECT_ID is read by the trigger CLI only.
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_ID=
# Used for links in worker-sent Slack/email notifications.
APP_URL=

# Agent tools (optional, agents degrade gracefully without them).
SERPER_API_KEY=
FIRECRAWL_API_KEY=
UNSTRUCTURED_API_KEY=

# File uploads (Cloudflare R2).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Billing (Stripe test mode).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_BUSINESS=

# Email (Resend).
RESEND_API_KEY=
EMAIL_FROM=

# Publishing + Slack connectors. CONNECTOR_ENCRYPTION_KEY is a 64-char hex key
# that encrypts stored OAuth tokens (openssl rand -hex 32).
CONNECTOR_ENCRYPTION_KEY=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TWITTER_API_KEY=
TWITTER_API_SECRET=
WORDPRESS_CLIENT_ID=
WORDPRESS_CLIENT_SECRET=

# Public URL of the app, set after the first deploy.
NEXT_PUBLIC_APP_URL=
# VERCEL_URL is injected automatically by Vercel during build; do not set it.
